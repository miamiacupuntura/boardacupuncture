{{!
    AcupunctureTests authentication layout.

    Moodle continues to render and process the authentication form through
    output.main_content. This template changes only the exterior presentation.
}}
{{> theme_moove/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}

<div id="page-wrapper" class="at-auth-wrapper">
    {{{ output.standard_top_of_body_html }}}

    <header class="at-auth-header">
        <div class="at-auth-shell at-auth-header-inner">
            <a class="at-brand" href="{{{wwwroot}}}/" aria-label="AcupunctureTests home">
                <span class="at-brand-mark" aria-hidden="true">
                    {{# output.should_display_logo }}
                        <img src="{{output.get_logo}}" alt="">
                    {{/ output.should_display_logo }}
                    {{^ output.should_display_logo }}
                        <span class="at-brand-symbol">☯</span>
                    {{/ output.should_display_logo }}
                </span>
                <span class="at-wordmark">Acupuncture<span>Tests</span></span>
            </a>

            <a class="at-auth-back" href="{{{wwwroot}}}/">← Back to home</a>
            {{#isloginpage}}
                <a class="at-button at-button-small at-button-orange" href="{{{signupurl}}}">Create account</a>
            {{/isloginpage}}
            {{#issignuppage}}
                <a class="at-button at-button-small at-button-outline" href="{{{loginurl}}}">Log in</a>
            {{/issignuppage}}
        </div>
    </header>

    <main id="page" class="at-auth-page">
        <div class="at-auth-shell at-auth-grid">
            <section class="at-auth-intro" aria-labelledby="at-auth-title">
                <p class="at-eyebrow">A clearer way to study</p>
                {{#isloginpage}}
                    <h1 id="at-auth-title">Welcome back.</h1>
                    <p>Continue your Board preparation, return to your Study Guides or access an approved Continuing Education course.</p>
                {{/isloginpage}}
                {{#issignuppage}}
                    <h1 id="at-auth-title">Create your learning account.</h1>
                    <p>Set up one account for your AcupunctureTests learning experience. Enrollment and payment remain specific to the path you choose.</p>
                {{/issignuppage}}
                {{^isloginpage}}
                    {{^issignuppage}}
                        <h1 id="at-auth-title">Your learning account.</h1>
                        <p>Use your AcupunctureTests account to manage your learning and course access.</p>
                    {{/issignuppage}}
                {{/isloginpage}}

                <div class="at-auth-paths">
                    <div>
                        <span class="at-auth-path-icon at-board">B</span>
                        <p><strong>Board Preparation</strong><small>Study Guides and Board-level practice</small></p>
                    </div>
                    <div>
                        <span class="at-auth-path-icon at-ce">CE</span>
                        <p><strong>Continuing Education</strong><small>Approved courses and certificates</small></p>
                    </div>
                </div>

                <div class="at-auth-visual">
                    <img src="{{{wwwroot}}}/study-guide/assets/point-categories-chapter-cover.webp"
                         alt="Conceptual illustration of acupuncture channels and point pathways"
                         width="1599" height="900">
                </div>
            </section>

            <section class="at-auth-card" aria-label="Account access">
                {{{ output.main_content }}}
                <p class="at-auth-help">Need help? <a href="{{{supporturl}}}">Contact support</a></p>
            </section>
        </div>
    </main>

    <footer class="at-auth-footer">
        <div class="at-auth-shell">
            <span>© 2026 AcupunctureTests</span>
            <nav aria-label="Authentication footer">
                <a href="{{{wwwroot}}}/study-guide/board-courses.html">Board Preparation</a>
                <a href="{{{wwwroot}}}/study-guide/continuing-education.html">Continuing Education</a>
                <a href="{{{supporturl}}}">Contact</a>
            </nav>
        </div>
    </footer>
</div>

<div class="d-none">
    {{{ output.standard_footer_html }}}
    {{{ output.standard_end_of_body_html }}}
</div>
</body>
</html>

{{#js}}
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader'], function() {
    M.util.js_complete('theme_boost/loader');
});
{{/js}}
