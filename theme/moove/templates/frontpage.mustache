{{!
    Public landing page for AcupunctureTests.

    The authenticated Moodle experience continues to use the drawers layout.
    This template is rendered only for visitors who are not logged in.
}}
{{> theme_moove/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}
<div id="page-wrapper" class="d-print-block at-public-home-wrapper">
    {{{ output.standard_top_of_body_html }}}

    <header class="at-site-header">
        <div class="at-shell at-header-inner">
            <a class="at-brand" href="{{{wwwroot}}}/" aria-label="AcupunctureTests home">
                <span class="at-brand-mark" aria-hidden="true">
                    {{# output.should_display_logo }}
                        <img src="{{output.get_logo}}" alt="">
                    {{/ output.should_display_logo }}
                    {{^ output.should_display_logo }}
                        <span class="at-brand-symbol">☯</span>
                    {{/ output.should_display_logo }}
                </span>
                <span class="at-wordmark">Acupuncture<span>Tests</span></span>
            </a>

            <button class="at-menu-button" type="button" aria-controls="at-primary-nav" aria-expanded="false">
                <span class="sr-only">Open navigation</span>
                <span aria-hidden="true"></span>
                <span aria-hidden="true"></span>
                <span aria-hidden="true"></span>
            </button>

            <nav class="at-primary-nav" id="at-primary-nav" aria-label="Primary navigation">
                <a href="#learning-paths">Learning Paths</a>
                <a href="#study-guides">Study Guides</a>
                <a href="#how-it-works">How It Works</a>
                <a href="{{{supporturl}}}">Contact</a>
                <div class="at-mobile-account-actions">
                    <a class="at-text-link" href="{{{loginurl}}}">Log in</a>
                    <a class="at-button at-button-small at-button-orange" href="{{{signupurl}}}">Create account</a>
                </div>
            </nav>

            <div class="at-account-actions">
                <a class="at-text-link" href="{{{loginurl}}}">Log in</a>
                <a class="at-button at-button-small at-button-orange" href="{{{signupurl}}}">Create account</a>
            </div>
        </div>
    </header>

    <main id="page" class="at-public-home" data-region="mainpage">
        <section class="at-hero">
            <div class="at-shell at-hero-grid">
                <div class="at-hero-copy">
                    <p class="at-eyebrow">Acupuncture education, organized around your goal</p>
                    <h1>Prepare for the Board.<br><span>Keep growing in practice.</span></h1>
                    <p class="at-hero-lead">Focused Study Guides for acupuncture Board preparation, plus a separate pathway for approved professional Continuing Education courses.</p>

                    <div class="at-hero-actions">
                        <a class="at-button at-button-teal" href="{{{wwwroot}}}/study-guide/board-courses.html">Explore Board Preparation</a>
                        <a class="at-button at-button-outline" href="{{{wwwroot}}}/study-guide/continuing-education.html">View Continuing Education</a>
                    </div>

                    <div class="at-hero-note" aria-label="Program highlights">
                        <span><i aria-hidden="true">✓</i> Self-paced learning</span>
                        <span><i aria-hidden="true">✓</i> Objective-based Study Guides</span>
                        <span><i aria-hidden="true">✓</i> Mobile friendly</span>
                    </div>
                </div>

                <div class="at-hero-visual">
                    <img src="{{{wwwroot}}}/study-guide/assets/point-categories-chapter-cover.webp"
                         alt="Conceptual illustration of acupuncture channels and point pathways"
                         width="1599" height="900" fetchpriority="high">
                    <div class="at-visual-card">
                        <span class="at-visual-icon" aria-hidden="true">◎</span>
                        <div>
                            <strong>Learn with direction</strong>
                            <small>Reading, visual review and targeted practice</small>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="at-quick-facts" aria-label="Membership and pricing">
            <div class="at-shell at-facts-grid">
                <div>
                    <span class="at-fact-icon at-teal">B</span>
                    <p><strong>Board Preparation</strong><small>$30 monthly membership</small></p>
                </div>
                <div>
                    <span class="at-fact-icon at-purple">CE</span>
                    <p><strong>Continuing Education</strong><small>$10 per approved credit</small></p>
                </div>
                <div>
                    <span class="at-fact-icon at-orange">24/7</span>
                    <p><strong>Study on your schedule</strong><small>Desktop, tablet or phone</small></p>
                </div>
            </div>
        </section>

        <section class="at-section at-paths-section" id="learning-paths">
            <div class="at-shell">
                <div class="at-section-heading">
                    <p class="at-eyebrow">Choose your learning path</p>
                    <h2>One platform. Two distinct goals.</h2>
                    <p>Use the same carefully organized subject matter in the path that fits where you are professionally.</p>
                </div>

                <div class="at-path-grid">
                    <article class="at-path-card at-board-card">
                        <div class="at-path-topline">
                            <span class="at-path-number">01</span>
                            <span class="at-pill at-pill-teal">Monthly membership</span>
                        </div>
                        <h3>Board Exam Preparation</h3>
                        <p>Build confidence through guided chapter reading, focused learning objectives, visual review and Board-level practice.</p>
                        <ul>
                            <li>Ready-to-study chapter guides</li>
                            <li>School- and Board-level practice</li>
                            <li>Progressive review by objective</li>
                        </ul>
                        <div class="at-path-footer">
                            <p><small>Full membership</small><strong>$30 <span>/ month</span></strong></p>
                            <a class="at-arrow-link" href="{{{wwwroot}}}/study-guide/board-courses.html">View Study Guides <span aria-hidden="true">→</span></a>
                        </div>
                    </article>

                    <article class="at-path-card at-ce-card">
                        <div class="at-path-topline">
                            <span class="at-path-number">02</span>
                            <span class="at-pill at-pill-purple">Professional education</span>
                        </div>
                        <h3>Continuing Education</h3>
                        <p>Access Board-approved courses individually, complete the required assessment and earn a course-specific certificate.</p>
                        <ul>
                            <li>Only approved and active courses appear</li>
                            <li>Separate enrollment by course</li>
                            <li>Completion record and certificate</li>
                        </ul>
                        <div class="at-path-footer">
                            <p><small>Course-specific price</small><strong>$10 <span>/ approved credit</span></strong></p>
                            <a class="at-arrow-link at-purple-link" href="{{{wwwroot}}}/study-guide/continuing-education.html">View CE Courses <span aria-hidden="true">→</span></a>
                        </div>
                    </article>
                </div>
            </div>
        </section>

        <section class="at-section at-guides-section" id="study-guides">
            <div class="at-shell">
                <div class="at-heading-row">
                    <div class="at-section-heading at-left">
                        <p class="at-eyebrow">Available now</p>
                        <h2>Focused Study Guides</h2>
                        <p>Each guide brings reading, learning objectives and targeted practice together in one clear sequence.</p>
                    </div>
                    <a class="at-quiet-link" href="{{{wwwroot}}}/study-guide/board-courses.html">View all Study Guides →</a>
                </div>

                <div class="at-guide-grid">
                    <article class="at-guide-card">
                        <div class="at-guide-art at-channels-art">
                            <span class="at-guide-kicker">9 objectives</span>
                            <span class="at-orbit at-one" aria-hidden="true"></span>
                            <span class="at-orbit at-two" aria-hidden="true"></span>
                            <span class="at-orbit at-three" aria-hidden="true"></span>
                            <span class="at-channel-symbol" aria-hidden="true">☯</span>
                        </div>
                        <div class="at-guide-content">
                            <span class="at-pill at-pill-teal">Study Guide ready</span>
                            <h3>The Channels and Collaterals</h3>
                            <p>Master channel functions, pathways, relationships and organization through guided reading and structured practice.</p>
                            <a class="at-arrow-link" href="{{{wwwroot}}}/study-guide/index.html#channels-chapter-introduction">Open Study Guide <span aria-hidden="true">→</span></a>
                        </div>
                    </article>

                    <article class="at-guide-card">
                        <div class="at-guide-art at-image-art">
                            <span class="at-guide-kicker">26 objectives</span>
                            <img src="{{{wwwroot}}}/study-guide/assets/point-categories-chapter-cover.webp"
                                 alt="Point Categories conceptual chapter cover" width="1599" height="900" loading="lazy">
                        </div>
                        <div class="at-guide-content">
                            <span class="at-pill at-pill-teal">Study Guide ready</span>
                            <h3>Point Categories</h3>
                            <p>Connect point classifications, channel correspondences and clinical reasoning through focused objective-level review.</p>
                            <a class="at-arrow-link" href="{{{wwwroot}}}/study-guide/index.html#point-categories-draft">Open Study Guide <span aria-hidden="true">→</span></a>
                        </div>
                    </article>
                </div>
            </div>
        </section>

        <section class="at-section at-process-section" id="how-it-works">
            <div class="at-shell at-process-grid">
                <div class="at-process-intro">
                    <p class="at-eyebrow">A clearer way to study</p>
                    <h2>Know what to learn and what to do next.</h2>
                    <p>Move through a consistent learning sequence designed to reduce guesswork and make progress visible.</p>
                    <a class="at-button at-button-orange" href="{{{signupurl}}}">Start your preparation</a>
                </div>

                <ol class="at-steps">
                    <li><span>1</span><div><h3>Choose your path</h3><p>Select Board Preparation or an approved Continuing Education course.</p></div></li>
                    <li><span>2</span><div><h3>Follow the learning plan</h3><p>Study each objective with reading, visual resources and guided review.</p></div></li>
                    <li><span>3</span><div><h3>Confirm your progress</h3><p>Use practice and assessments to determine when you have mastered the material.</p></div></li>
                </ol>
            </div>
        </section>

        <section class="at-final-cta">
            <div class="at-shell at-cta-inner">
                <div>
                    <p class="at-eyebrow at-light">Start with a clear plan</p>
                    <h2>Your next chapter begins here.</h2>
                </div>
                <div class="at-cta-actions">
                    <a class="at-button at-button-white" href="{{{wwwroot}}}/study-guide/board-courses.html">Explore Board Preparation</a>
                    <a class="at-button at-button-ghost" href="{{{loginurl}}}">Log in</a>
                </div>
            </div>
        </section>
    </main>

    <footer class="at-site-footer">
        <div class="at-shell at-footer-grid">
            <div>
                <a class="at-brand at-footer-brand" href="{{{wwwroot}}}/">
                    <span class="at-brand-mark" aria-hidden="true">
                        {{# output.should_display_logo }}
                            <img src="{{output.get_logo}}" alt="">
                        {{/ output.should_display_logo }}
                        {{^ output.should_display_logo }}
                            <span class="at-brand-symbol">☯</span>
                        {{/ output.should_display_logo }}
                    </span>
                    <span class="at-wordmark">Acupuncture<span>Tests</span></span>
                </a>
                <p>Structured learning for acupuncture Board preparation and professional development.</p>
            </div>
            <div>
                <h2>Learning</h2>
                <a href="{{{wwwroot}}}/study-guide/board-courses.html">Board Preparation</a>
                <a href="{{{wwwroot}}}/study-guide/continuing-education.html">Continuing Education</a>
                <a href="#study-guides">Study Guides</a>
            </div>
            <div>
                <h2>Support</h2>
                <a href="{{{supporturl}}}">Contact Us</a>
                <a href="{{{loginurl}}}">Log in</a>
                <a href="{{{signupurl}}}">Create account</a>
            </div>
        </div>
        <div class="at-shell at-footer-bottom">
            <span>© 2026 AcupunctureTests</span>
            <span>Education designed for focused progress.</span>
        </div>
    </footer>

    {{{ output.standard_after_main_region_html }}}
</div>

{{#js}}
const menuButton = document.querySelector('.at-menu-button');
const primaryNav = document.querySelector('.at-primary-nav');

if (menuButton && primaryNav) {
    menuButton.addEventListener('click', function() {
        const isOpen = menuButton.getAttribute('aria-expanded') === 'true';
        menuButton.setAttribute('aria-expanded', String(!isOpen));
        primaryNav.classList.toggle('is-open');
    });

    primaryNav.querySelectorAll('a').forEach(function(link) {
        link.addEventListener('click', function() {
            menuButton.setAttribute('aria-expanded', 'false');
            primaryNav.classList.remove('is-open');
        });
    });
}
{{/js}}
</body>
</html>
